{
  "compilerOptions": {
    "target": "5.4",
    "strict": true,
    "strictNilChecks": true,
    "noImplicitAny": true,
    "rootDir": ".",
    "outDir": "dist",
    "typeRoots": [
      "types"
    ]
  },
  "include": [
    "**/*.tl"
  ],
  "exclude": [
    "dist",
    "data",
    ".typelua"
  ]
}
